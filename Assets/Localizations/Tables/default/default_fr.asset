  m_TableData:
  - m_Id: 15122665883082752
    m_Localized: "Il s'agit \xE9galement d'un cluster important n\xE9cessaire au
      pavage ap\xE9riodique."
    m_Metadata:
      m_Items: []
  - m_Id: 128638358116409344
    m_Localized: "Cette combinaison de tuiles a re\xE7u le surnom de \xAB Mystic
      \xBB dans l'article."
    m_Metadata:
      m_Items: []
  - m_Id: 15121970022883328
    m_Localized: "1. Cliquez sur la tuile en bas \xE0 droite pour la saisir.\r\n2.
      Utilisez la molette de la souris pour faire pivoter la tuile.\r\n3. Cliquez
      pour placer la tuile."
    m_Metadata:
      m_Items: []
